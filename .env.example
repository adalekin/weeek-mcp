# --- Task management (public REST API) ---
# Create a token in Weeek: Settings -> API. Requests act as the token's creator.
WEEEK_API_TOKEN=

# Optional overrides
# WEEEK_API_BASE=https://api.weeek.net/public/v1

# --- Knowledge base (Playwright) ---
# Used for the FIRST automated login only; afterwards the cached session is reused.
# If your account has 2FA/captcha, skip these and run `weeek-mcp-login` once instead.
WEEEK_EMAIL=
WEEEK_PASSWORD=

# Optional overrides
# WEEEK_APP_BASE=https://app.weeek.net
# WEEEK_STORAGE_STATE=/absolute/path/to/storage_state.json
# WEEEK_HEADLESS=true
# WEEEK_KB_CACHE_TTL=300
